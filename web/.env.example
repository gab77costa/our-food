# Copia in .env.local e compila con la configurazione web dell'app Firebase
# (Console Firebase → Impostazioni progetto → Le tue app → App web → Configurazione SDK).
# Non sono segreti: finiscono comunque nel codice pubblicato.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ourfoodhub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ourfoodhub
VITE_FIREBASE_APP_ID=

# Regione delle Cloud Functions
VITE_FUNCTIONS_REGION=europe-west8

# false = nessuna chiamata all'AI: i nomi mai visti si categorizzano a mano.
# Con false si può pubblicare senza Cloud Function: npm run deploy:noai
VITE_AI_ENABLED=true

# true = usa gli emulatori locali (auth, firestore, functions) invece del cloud
VITE_USE_EMULATORS=false
